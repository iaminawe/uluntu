# Production Dockerfile with explicit environment handling
FROM node:20-alpine AS builder

# Install dependencies for building
RUN apk add --no-cache python3 make g++

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies
RUN npm ci

# Copy source code
COPY . .

# CRITICAL: Accept ALL build arguments
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_APP_URL
ARG VITE_ENVIRONMENT=production
ARG VITE_FROM_EMAIL
ARG VITE_FROM_NAME
ARG VITE_RESEND_API_KEY
ARG VITE_GOOGLE_ANALYTICS_ID
ARG VITE_SENTRY_DSN
ARG VITE_ENABLE_NEWSLETTER=true
ARG VITE_ENABLE_GALLERY=true
ARG VITE_ENABLE_MARKETPLACE=true
ARG VITE_ENABLE_GROUPS=true
ARG VITE_ENABLE_EVENTS=true

# CRITICAL: Export them as environment variables for the build
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT
ENV VITE_FROM_EMAIL=$VITE_FROM_EMAIL
ENV VITE_FROM_NAME=$VITE_FROM_NAME
ENV VITE_RESEND_API_KEY=$VITE_RESEND_API_KEY
ENV VITE_GOOGLE_ANALYTICS_ID=$VITE_GOOGLE_ANALYTICS_ID
ENV VITE_SENTRY_DSN=$VITE_SENTRY_DSN
ENV VITE_ENABLE_NEWSLETTER=$VITE_ENABLE_NEWSLETTER
ENV VITE_ENABLE_GALLERY=$VITE_ENABLE_GALLERY
ENV VITE_ENABLE_MARKETPLACE=$VITE_ENABLE_MARKETPLACE
ENV VITE_ENABLE_GROUPS=$VITE_ENABLE_GROUPS
ENV VITE_ENABLE_EVENTS=$VITE_ENABLE_EVENTS

# Debug: Log environment variables (remove in production)
RUN echo "Building with environment variables:" && \
    echo "VITE_SUPABASE_URL=${VITE_SUPABASE_URL}" && \
    echo "VITE_APP_URL=${VITE_APP_URL}" && \
    echo "VITE_ENVIRONMENT=${VITE_ENVIRONMENT}"

# Build the application
RUN npm run build

# Verify build contains environment variables
RUN echo "Verifying build..." && \
    if grep -q "supabase.co" dist/js/*.js 2>/dev/null || grep -q "supabase.co" dist/*.js 2>/dev/null; then \
        echo "✅ Build verification passed - Supabase URL found in built files"; \
    else \
        echo "⚠️  WARNING: Supabase URL not found in built files - environment variables may not be set correctly"; \
    fi

# Production stage
FROM nginx:alpine

# Install curl for healthcheck
RUN apk add --no-cache curl

# Copy custom nginx config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Add healthcheck
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost/health || exit 1

# Create health endpoint
RUN echo "OK" > /usr/share/nginx/html/health

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]