# Minimal Dockerfile for single container deployment
# Serves both static frontend and optional API routes

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (including dev for building)
RUN npm ci

# Copy source code
COPY . .

# IMPORTANT: Accept build arguments for Vite
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_APP_URL
ARG VITE_ENVIRONMENT=production

# Set environment variables for build
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_APP_URL=$VITE_APP_URL
ENV VITE_ENVIRONMENT=$VITE_ENVIRONMENT

# Build the application
RUN npm run build

# Production stage - Single container for everything
FROM node:20-alpine

# Install serve for static file serving and curl for healthcheck
RUN npm install -g serve && \
    apk add --no-cache curl

WORKDIR /app

# Copy built frontend assets
COPY --from=builder /app/dist ./dist

# Copy package files for any backend dependencies
COPY package*.json ./

# Install only production dependencies (if you have API routes)
RUN npm ci --only=production && \
    npm cache clean --force

# Copy any backend/API files (if applicable)
# COPY api ./api
# COPY server.js ./

# Create a simple serve configuration
RUN echo '{ \
  "rewrites": [ \
    { "source": "/api/**", "destination": "/api/404" }, \
    { "source": "/**", "destination": "/index.html" } \
  ], \
  "headers": [ \
    { \
      "source": "**/*.@(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)", \
      "headers": [ \
        { \
          "key": "Cache-Control", \
          "value": "public, max-age=31536000, immutable" \
        } \
      ] \
    } \
  ] \
}' > serve.json

# Add health check endpoint
RUN echo "OK" > dist/health

# Expose port
EXPOSE 3000

# Start the application
# If you have a backend server, replace this with your server command
CMD ["serve", "-s", "dist", "-l", "3000", "-c", "../serve.json"]