# Uluntu environment variables
# Copy this file to .env and fill in your values

# ===========================================
# FRONTEND CONFIGURATION
# ===========================================

# Application URLs
VITE_APP_URL=http://localhost:5555
VITE_ENVIRONMENT=development
SITE_URL=http://localhost:5555

# Supabase Frontend Keys
# Hosted: https://<project-ref>.supabase.co   Local (`supabase start`): http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Newsletter Service (Resend.com)
# SECURITY: Resend key is SERVER-SIDE ONLY (used by /api/email). No VITE_ prefix.
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=newsletter@yourdomain.com   # server default "from" address
SUPPORT_EMAIL=support@yourdomain.com   # server: allowed anon contact recipient
VITE_FROM_EMAIL=newsletter@yourdomain.com  # non-secret display default
VITE_FROM_NAME=Uluntu Community

# Optional: Analytics & Monitoring
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# ===========================================
# BACKEND CONFIGURATION (Docker/Coolify)
# ===========================================

# API URLs
API_EXTERNAL_URL=http://localhost:8000

# Supabase Backend Keys
SUPABASE_SERVICE_KEY=your-service-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ACCESS_TOKEN=your-access-token-here

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=uluntu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# JWT Configuration (min 32 characters)
JWT_SECRET=your-super-secret-jwt-key-at-least-32-chars
JWT_EXPIRY=3600

# ===========================================
# EMAIL CONFIGURATION
# ===========================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-specific-password
SMTP_ADMIN_EMAIL=admin@your-domain.com

# Email Features
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false

# ===========================================
# AUTHENTICATION
# ===========================================

# Auth Settings
DISABLE_SIGNUP=false
ADDITIONAL_REDIRECT_URLS=http://localhost:5555
ENABLE_ANONYMOUS_SIGN_INS=false

# OAuth Providers (Optional)
ENABLE_GITHUB_OAUTH=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

ENABLE_GOOGLE_OAUTH=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===========================================
# STORAGE & SERVICES
# ===========================================

# Storage Configuration
STORAGE_BACKEND=file
FILE_SIZE_LIMIT=52428800

# Storage Buckets
VITE_PROFILE_IMAGES_BUCKET=profile-images
VITE_CONTENT_IMAGES_BUCKET=content-images
VITE_GROUP_IMAGES_BUCKET=group-images
VITE_BACKGROUND_IMAGES_BUCKET=background-images

# S3 Storage (Optional)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=

# API Configuration
PGRST_DB_SCHEMAS=public,storage,extensions
PROJECT_REF=default

# Analytics (Optional)
LOGFLARE_API_KEY=
ENABLE_ANALYTICS=false

# ===========================================
# DEVELOPMENT PORTS
# ===========================================

# Service Ports (for local development)
FRONTEND_PORT=3000
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443
STUDIO_PORT=54323

# ===========================================
# AI CONFIGURATION
# ===========================================
# SECURITY: API keys are SERVER-SIDE ONLY (used by /api/ai). NEVER give a secret
# a VITE_ prefix — Vite loads every VITE_* var into import.meta.env, which is
# emitted into the public client bundle (and third-party code such as zustand
# references the whole object, dumping every VITE_* secret). Server env only:

# OpenAI (server-side, no VITE_ prefix)
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# Anthropic (server-side, no VITE_ prefix)
ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-3-haiku-20240307

# Server-side provider selection
AI_PROVIDER=openai # options: openai, anthropic

# AI Feature Settings (non-secret; VITE_ ok — used by the client UI)
VITE_AI_PROVIDER=openai # display hint only
VITE_AI_ENABLED=true
VITE_AI_MAX_TOKENS=4000
VITE_AI_TEMPERATURE=0.7

# Unsplash API Configuration (for AI image insertion)
VITE_UNSPLASH_ACCESS_KEY=   # public access key only; never put the Unsplash secret key in a VITE_ var

# ===========================================
# FEATURE FLAGS
# ===========================================

ENABLE_NEWSLETTER=true
ENABLE_GALLERY=true
ENABLE_MARKETPLACE=true
ENABLE_GROUPS=true
ENABLE_EVENTS=true
ENABLE_AI_EDITOR=true

# ===========================================
# DEPLOYMENT (Coolify)
# ===========================================

# Coolify Specific (when deploying)
# COOLIFY_URL=https://coolify.your-domain.com
# COOLIFY_TOKEN=your-coolify-api-token