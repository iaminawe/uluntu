# Uluntu environment variables
# Local development: copy to .env.local. Vercel: set these under
# Project Settings -> Environment Variables. Docker Compose: copy to .env.
#
# SECURITY: anything starting with VITE_ is inlined into the public JavaScript
# bundle. Never give a secret a VITE_ prefix. Secrets below have no prefix and
# are only read by the serverless functions in api/ and by scripts/.

# ---------------------------------------------------------------------------
# Browser (public)
# ---------------------------------------------------------------------------

# Hosted: https://<project-ref>.supabase.co   Local (`supabase start`): http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
# The publishable (anon) key — safe for the browser.
VITE_SUPABASE_ANON_KEY=

VITE_APP_URL=http://localhost:5555
VITE_FROM_EMAIL=newsletter@yourdomain.com
VITE_FROM_NAME=Uluntu Community
VITE_SUPPORT_EMAIL=support@yourdomain.com
VITE_SUPPORT_NAME=Uluntu Support
# VITE_LOGO_URL=

# Storage buckets
VITE_PROFILE_IMAGES_BUCKET=profile-images
VITE_CONTENT_IMAGES_BUCKET=content-images
VITE_GROUP_IMAGES_BUCKET=group-images
VITE_BACKGROUND_IMAGES_BUCKET=background-images

# Editor AI features (UI settings only; keys live server-side)
VITE_AI_ENABLED=true
VITE_AI_PROVIDER=openai
VITE_AI_MAX_TOKENS=4000
VITE_AI_TEMPERATURE=0.7

# Optional public API keys (restrict them by domain in the provider's console)
# VITE_UNSPLASH_ACCESS_KEY=
# VITE_GOOGLE_FONTS_API_KEY=

# ---------------------------------------------------------------------------
# Server only (api/ functions and scripts/) — secrets
# ---------------------------------------------------------------------------

SUPABASE_URL=http://127.0.0.1:54321
# The secret key (sb_secret_...). Used by api/ for role checks and by scripts/.
SUPABASE_SECRET_KEY=
# Older name, still accepted by api/ and used by scripts/:
# SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend) for api/email
RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Uluntu
SUPPORT_EMAIL=support@yourdomain.com

# AI proxy for api/ai
AI_PROVIDER=openai   # openai or anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# AI_OPENAI_MODEL=gpt-4o-mini
# AI_ANTHROPIC_MODEL=claude-haiku-5-5
# AI_MAX_TOKENS=
# AI_TEMPERATURE=

# Nostr (api/nostr/*): NIP-05 identity and publishing public content.
# See docs/features/nostr.md. Publishing can't be undone, so it stays off
# until NOSTR_PUBLISH_ENABLED=true.
# NOSTR_SECRET_KEY=           # instance key, hex or nsec; server-only
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net
# NOSTR_PUBLISH_ENABLED=false
# NOSTR_PROFILE_NAME=
# NOSTR_PROFILE_ABOUT=
# NOSTR_PROFILE_PICTURE=
# NOSTR_EVENT_TIMEZONE=America/Vancouver
# SITE_URL=https://uluntu.io  # canonical origin for links and NIP-05 names
# CRON_SECRET=                # Vercel sends this to the daily publish cron

# ---------------------------------------------------------------------------
# Optional: self-hosting with docker-compose.yml
# Runs the frontend (nginx) plus a self-hosted Supabase stack. Not needed for
# Vercel or for local development with `supabase start`.
# ---------------------------------------------------------------------------

# FRONTEND_PORT=3000
# SITE_URL=http://localhost:3000
# API_EXTERNAL_URL=http://localhost:8000
# SUPABASE_PUBLIC_URL=http://localhost:8000
# KONG_HTTP_PORT=8000
# KONG_HTTPS_PORT=8443
# STUDIO_PORT=54323
# STUDIO_DEFAULT_ORGANIZATION_NAME=Uluntu
# STUDIO_DEFAULT_PROJECT_NAME=Uluntu
#
# POSTGRES_DB=uluntu
# POSTGRES_PORT=5432
# POSTGRES_PASSWORD=change-me
# JWT_SECRET=change-me-to-at-least-32-random-characters
# JWT_EXPIRY=3600
# Keys signed with JWT_SECRET (see Supabase's self-hosting guide):
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_KEY=
# PGRST_DB_SCHEMAS=public,storage,graphql_public
# PROJECT_REF=default
#
# Auth
# DISABLE_SIGNUP=false
# ENABLE_EMAIL_SIGNUP=true
# ENABLE_EMAIL_AUTOCONFIRM=false
# ENABLE_ANONYMOUS_SIGN_INS=false
# ADDITIONAL_REDIRECT_URLS=
# ENABLE_GITHUB_OAUTH=false
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# ENABLE_GOOGLE_OAUTH=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# SMTP for auth emails
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_ADMIN_EMAIL=
#
# LOGFLARE_API_KEY=
