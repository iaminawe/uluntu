{
  "name": "kootenay-tech-community",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:full": "npm run typecheck && vite build",
    "build:skip-typecheck": "vite build --mode production",
    "build:analyze": "vite build --config vite.config.performance.ts",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "clean": "rm -rf dist build coverage .tsbuildinfo node.tsbuildinfo tsconfig.tsbuildinfo",
    "clean:cache": "rm -rf node_modules/.vite node_modules/.cache",
    "prebuild": "npm run clean",
    "postinstall": "npm run clean:cache",
    "preview": "vite preview",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:debug": "node --inspect-brk ./node_modules/.bin/jest --runInBand",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "typecheck:watch": "tsc --noEmit --skipLibCheck --watch",
    "typecheck:strict": "tsc --noEmit",
    "perf:analyze": "npm run build:analyze",
    "perf:baseline": "npm run build && node -e \"console.log('Bundle size baseline captured')\"",
    "perf:report": "npm run build:analyze && open dist/stats.html",
    "migrate:topics": "./database/migrations/apply_topics_migration.sh",
    "validate:topics": "node scripts/simple-topics-validation.js",
    "validate:topics-full": "npx ts-node scripts/validate-topics-integration.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headlessui/react": "^2.2.7",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.8.2",
    "@storybook/react": "^9.1.3",
    "@supabase/supabase-js": "^2.49.8",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.17.19",
    "@tanstack/react-query-devtools": "^5.17.21",
    "@tiptap/extension-placeholder": "^2.22.3",
    "@tiptap/react": "^2.22.3",
    "@tiptap/starter-kit": "^2.22.3",
    "@types/papaparse": "^5.3.16",
    "@types/react-beautiful-dnd": "^13.1.8",
    "@types/uuid": "^10.0.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.3.1",
    "dotenv": "^16.5.0",
    "framer-motion": "^12.18.1",
    "lucide-react": "^0.344.0",
    "moment": "^2.30.1",
    "novel": "^1.0.2",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-beautiful-dnd": "^13.1.1",
    "react-big-calendar": "^1.18.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.4",
    "react-hot-toast": "^2.5.2",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.22.0",
    "resend": "^4.6.0",
    "slugify": "^1.6.6",
    "tailwind-merge": "^3.3.1",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "uuid": "^11.1.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/core": "^7.27.3",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.0.0",
    "@faker-js/faker": "^9.9.0",
    "@playwright/test": "^1.54.2",
    "@swc/core": "^1.4.8",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/moment": "^2.11.29",
    "@types/node": "^20.17.50",
    "@types/react": "^18.2.52",
    "@types/react-big-calendar": "^1.16.1",
    "@types/react-dom": "^18.2.18",
    "@types/redux-logger": "^3.0.13",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "babel-jest": "^29.7.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "globals": "^16.3.0",
    "jest": "^29.7.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.35",
    "react-hook-form": "^7.62.0",
    "redux-logger": "^3.0.6",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.3.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^5.0.12"
  }
}
